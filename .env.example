# Backend Configuration (.env in backend/ or root)
DEBUG=True
SECRET_KEY=change-me-to-a-secure-random-secret-key
ALLOWED_HOSTS=*

# Database: Leave empty for local SQLite, or provide PostgreSQL URI
DATABASE_URL=postgres://voicetext_user:voicetext_password@localhost:5432/voicetext

# Optional Redis for Channels (defaults to InMemoryChannelLayer if omitted)
REDIS_URL=

# Google Gemini API (Get free key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp
GEMINI_TEXT_MODEL=gemini-1.5-flash

# Frontend Configuration (.env in frontend/)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/transcribe/
